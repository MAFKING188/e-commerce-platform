{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.30",
        "laravel/tinker": "^3.0",
        "nwidart/laravel-modules": "^13.0",
        "pragmarx/google2fa-laravel": "^3.0",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "srmklive/paypal": "^3.1",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\CatalogDelivery\\": "Modules/CatalogDelivery/app/",
            "Modules\\CatalogDelivery\\Database\\Factories\\": "Modules/CatalogDelivery/database/factories/",
            "Modules\\CatalogDelivery\\Database\\Seeders\\": "Modules/CatalogDelivery/database/seeders/",
            "Modules\\CatalogDelivery\\Exceptions\\": "Modules/CatalogDelivery/Exceptions/",
            "Modules\\IdentityAccess\\": "Modules/IdentityAccess/app/",
            "Modules\\IdentityAccess\\Database\\Factories\\": "Modules/IdentityAccess/database/factories/",
            "Modules\\IdentityAccess\\Exceptions\\": "Modules/IdentityAccess/Exceptions/",
            "Modules\\IdentityAccess\\Database\\Factories\\": "Modules/IdentityAccess/database/factories/",
            "Modules\\IdentityAccess\\Database\\Seeders\\": "Modules/IdentityAccess/database/seeders/",
            "Modules\\MarketplacePipeline\\": "Modules/MarketplacePipeline/app/",
            "Modules\\MarketplacePipeline\\Database\\Factories\\": "Modules/MarketplacePipeline/database/factories/",
            "Modules\\MarketplacePipeline\\Database\\Seeders\\": "Modules/MarketplacePipeline/database/seeders/",
            "Modules\\MarketplacePipeline\\Exceptions\\": "Modules/MarketplacePipeline/Exceptions/",
            "Modules\\PartnerHub\\": "Modules/PartnerHub/app/",
            "Modules\\PartnerHub\\Database\\Factories\\": "Modules/PartnerHub/database/factories/",
            "Modules\\PartnerHub\\Database\\Seeders\\": "Modules/PartnerHub/database/seeders/",
            "Modules\\PartnerHub\\Exceptions\\": "Modules/PartnerHub/Exceptions/",
            "Modules\\TelemetryPipeline\\": "Modules/TelemetryPipeline/app/",
            "Modules\\TelemetryPipeline\\Database\\Factories\\": "Modules/TelemetryPipeline/database/factories/",
            "Modules\\TelemetryPipeline\\Database\\Seeders\\": "Modules/TelemetryPipeline/database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Modules\\CatalogDelivery\\Tests\\": "Modules/CatalogDelivery/tests/",
            "Modules\\IdentityAccess\\Tests\\": "Modules/IdentityAccess/tests/",
            "Modules\\MarketplacePipeline\\Tests\\": "Modules/MarketplacePipeline/tests/",
            "Modules\\PartnerHub\\Tests\\": "Modules/PartnerHub/tests/",
            "Modules\\TelemetryPipeline\\Tests\\": "Modules/TelemetryPipeline/tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": ["Modules/*/composer.json"]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
